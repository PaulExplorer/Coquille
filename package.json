{
  "name": "coquille",
  "title": "Coquille",
  "description": "Correcteur d'orthographe et de grammaire en place, propulsé par le moteur Grammalecte.",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "smoke:engine": "node scripts/smoke_engine.mjs",
    "lint": "wxt prepare && npm run compile && biome check .",
    "update-engine": "python3 scripts/update_engine.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.1.4",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "web-ext": "^9.2.0",
    "wxt": "^0.21.4"
  }
}
